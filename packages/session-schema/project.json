{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "session-schema",
  "projectType": "library",
  "sourceRoot": "packages/session-schema/src",
  "tags": ["scope:schema", "type:lib"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "rslib build", "cwd": "packages/session-schema" },
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "packages/session-schema"
      },
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run", "cwd": "packages/session-schema" },
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint src", "cwd": "packages/session-schema" },
      "cache": true
    }
  }
}
